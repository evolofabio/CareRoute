# CareRoute — environment template
# Demo mode works with NO env vars (localStorage).
#
# Supabase: create a free project named CareRoute (eu-west-1 recommended),
# apply supabase/migrations/*.sql, then fill:

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (server-only, never expose to browser):
# SUPABASE_SERVICE_ROLE_KEY=
